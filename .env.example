# Sathya Sai Trust - Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.

# Google Gemini AI Config
GEMINI_API_KEY=""

# Supabase DB Config
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key_here"
# Server-only. From Supabase Dashboard -> Settings -> API -> service_role (secret). Used by the razorpay webhook.
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# Razorpay Seva (Contribution) Config
# Keys from https://dashboard.razorpay.com/app/keys (live mode)
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"          # secret, server-only
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"  # secret, must match webhook secret set on Razorpay
# Pre-created Razorpay Payment Link (QR Seva) — ID from Dashboard -> Payment Links -> "plink_..."
RAZORPAY_PAYMENT_LINK_ID="plink_xxxxxxxxxxxxxxxx"
# Pre-created Razorpay Subscription (Monthly Seva / autopay) — ID from Dashboard -> Subscriptions -> "sub_..."
RAZORPAY_SUBSCRIPTION_ID="sub_xxxxxxxxxxxxxxxx"

# Telegram Bot Config
# Create a bot via @BotFather on Telegram to get a token
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
# Chat ID to receive Seva alerts (optional; e.g. admin group chat id)
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# Resend Email Config — event notifications & welcome emails
# Get an API key at https://resend.com/api-keys (starts with re_)
RESEND_API_KEY="re_your_api_key_here"
# Verified sending domain (DNS) for the trust
RESEND_FROM_NAME="Sathya Sai Prema Kuteeram"
RESEND_FROM_EMAIL="noreply@mail.saidharmasamrakshanapremakuteeram.qzz.io"
