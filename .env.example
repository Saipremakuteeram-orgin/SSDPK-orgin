# ── Trust Website environment (Vercel) ────────────────────────────────────────
# These are read by the serverless API functions (api/*.js) at runtime.
# Set them in the Vercel project settings (Settings > Environment Variables).

# Supabase (anon key is safe client-side; service role is server-only)
SUPABASE_URL=https://zkzotagctwqthxypczej.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_KEEP_SECRET

# Gemini (chatbot)
GEMINI_API_KEY=your_gemini_api_key

# Resend (event notification emails)
RESEND_API_KEY=your_resend_api_key

# ── CRM integration (auto-create a budget Function when a website event is added) ──
# The website's api/notify-event POSTs the new event here. The secret must match
# WEBHOOK_SECRET in the CRM backend environment. Generate: openssl rand -hex 32
# CURRENT VALUE (generated 2026-08-31): 2ad2a205edfd3bf53d3c5a44605402201d04397bbdbf2d4d70dbd93135aedbab
# Paste the SAME value into Vercel (this var) and Render (WEBHOOK_SECRET).
CRM_WEBHOOK_URL=https://crmsaidharmasamrakshanapremakuteeram.dpdns.org/api/webhooks/website-event
CRM_WEBHOOK_SECRET=2ad2a205edfd3bf53d3c5a44605402201d04397bbdbf2d4d70dbd93135aedbab
