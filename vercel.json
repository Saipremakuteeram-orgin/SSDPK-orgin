{
  "cleanUrls": true,
  "framework": null,
  "rewrites": [
    { "source": "/", "destination": "/pages/index" },
    { "source": "/index.html", "destination": "/pages/index" },
    { "source": "/about", "destination": "/pages/about" },
    { "source": "/about.html", "destination": "/pages/about" },
    { "source": "/dashboard", "destination": "/pages/dashboard" },
    { "source": "/dashboard.html", "destination": "/pages/dashboard" },
    { "source": "/discourse", "destination": "/pages/discourse" },
    { "source": "/discourse.html", "destination": "/pages/discourse" },
    { "source": "/events", "destination": "/pages/events" },
    { "source": "/events.html", "destination": "/pages/events" },
    { "source": "/gallery", "destination": "/pages/gallery" },
    { "source": "/gallery.html", "destination": "/pages/gallery" },
    { "source": "/login", "destination": "/pages/login" },
    { "source": "/login.html", "destination": "/pages/login" },
    { "source": "/reset-password", "destination": "/pages/reset-password" },
    { "source": "/reset-password.html", "destination": "/pages/reset-password" },
    { "source": "/seva", "destination": "/pages/seva" },
    { "source": "/seva.html", "destination": "/pages/seva" },
    { "source": "/signup", "destination": "/pages/signup" },
    { "source": "/signup.html", "destination": "/pages/signup" },
    { "source": "/trustees", "destination": "/pages/trustees" },
    { "source": "/trustees.html", "destination": "/pages/trustees" },
    { "source": "/privacy", "destination": "/pages/privacy" },
    { "source": "/privacy.html", "destination": "/pages/privacy" },
    { "source": "/terms", "destination": "/pages/terms" },
    { "source": "/terms.html", "destination": "/pages/terms" },
    { "source": "/contact", "destination": "/pages/contact" },
    { "source": "/contact.html", "destination": "/pages/contact" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap.js" },
    { "source": "/api/config", "destination": "/api/config.js" },
    { "source": "/api/notify-event", "destination": "/api/notify-event.js" },
    { "source": "/api/send-welcome", "destination": "/api/send-welcome.js" },
    { "source": "/api/razorpay/order", "destination": "/api/razorpay?action=order" },
    { "source": "/api/razorpay/payment-link", "destination": "/api/razorpay?action=payment-link" },
    { "source": "/api/razorpay/subscription", "destination": "/api/razorpay?action=subscription" },
    { "source": "/api/razorpay/config", "destination": "/api/razorpay?action=config" },
    { "source": "/api/razorpay/history", "destination": "/api/razorpay?action=history" },
    { "source": "/api/razorpay/subscribe", "destination": "/api/razorpay?action=subscribe" },
    { "source": "/api/razorpay/plans", "destination": "/api/razorpay?action=plans" },
    { "source": "/api/razorpay/webhook", "destination": "/api/razorpay?action=webhook" },
    { "source": "/api/telegram-upload", "destination": "/api/weekly-messages" },
    { "source": "/api/weekly-media", "destination": "/api/weekly-messages" },
    { "source": "/api/event-report", "destination": "/api/weekly-messages" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://cdn.jsdelivr.net https://checkout.razorpay.com https://cdn.razorpay.com https://api.stripe.com https://static.cloudflareinsights.com https://vercel.live; style-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://db.onlinewebfonts.com; img-src 'self' data: blob: https://zkzotagctwqthxypczej.supabase.co; font-src 'self' data: https://db.onlinewebfonts.com; connect-src 'self' https://zkzotagctwqthxypczej.supabase.co https://api.razorpay.com https://checkout.razorpay.com https://api.stripe.com; frame-src https://checkout.razorpay.com https://api.stripe.com https://vercel.live; media-src 'self' https://zkzotagctwqthxypczej.supabase.co blob:" }
      ]
    }
  ]
}
